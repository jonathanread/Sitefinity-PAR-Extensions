<?xml version="1.0" encoding="utf-8"?>
<webSecurityConfig xmlns:config="urn:telerik:sitefinity:configuration" xmlns:type="urn:telerik:sitefinity:configuration:type" config:version="15.4.8641.0">
	<httpSecurityHeaders>
		<responseHeaders>
			<add name="Content-Security-Policy" config:flags="1">
				<directives>
					<add name="style-src" config:flags="1">
						<values>
							<add value="cdn.assistant.cloud.sitefinity.com" />
						</values>
					</add>
				</directives>
			</add>
		</responseHeaders>
	</httpSecurityHeaders>
</webSecurityConfig>